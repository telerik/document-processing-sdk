		<PackageReference Include="Telerik.Windows.Controls.Data.for.Wpf.Xaml" Version="*" />
		<PackageReference Include="Telerik.Windows.Controls.GridView.for.Wpf.Xaml" Version="*" />
		<PackageReference Include="Telerik.Windows.Controls.Input.for.Wpf.Xaml" Version="*" />
		<PackageReference Include="Telerik.Windows.Controls.Navigation.for.Wpf.Xaml" Version="*" />
		<PackageReference Include="Telerik.Windows.Controls.RibbonView.for.Wpf.Xaml" Version="*" />
		<PackageReference Include="Telerik.Windows.Controls.ConversationalUI.for.Wpf.Xaml" Version="*" />
		<PackageReference Include="Telerik.Windows.Controls.Spreadsheet.for.Wpf.Xaml" Version="*" />
		<PackageReference Include="Telerik.Windows.Controls.SpreadsheetUI.for.Wpf.Xaml" Version="*" />
		<PackageReference Include="Telerik.Windows.Data.for.Wpf.Xaml" Version="*" />

		<!-- Telerik Document Processing -->
		<PackageReference Include="Telerik.Windows.Documents.Spreadsheet" Version="*" />
		<PackageReference Include="Telerik.Windows.Documents.Spreadsheet.FormatProviders.OpenXml" Version="*" />
		<PackageReference Include="Telerik.Windows.Documents.Spreadsheet.FormatProviders.Pdf" Version="*" />
		<PackageReference Include="Telerik.Windows.Documents.Spreadsheet.FormatProviders.Xls" Version="*" />
		<PackageReference Include="Telerik.Documents.AI.AgentTools.Spreadsheet" Version="*" />

