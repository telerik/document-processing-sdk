<Window x:Class="AgentToolsInSpreadsheet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AgentToolsInSpreadsheet"
        mc:Ignorable="d"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        xmlns:conversational="clr-namespace:Telerik.Windows.Controls.ConversationalUI;assembly=Telerik.Windows.Controls.ConversationalUI"
        xmlns:spreadsheetControls="clr-namespace:Telerik.Windows.Controls.Spreadsheet.Controls;assembly=Telerik.Windows.Controls.Spreadsheet"
        xmlns:spreadsheet="clr-namespace:Telerik.Windows.Controls.Spreadsheet;assembly=Telerik.Windows.Controls.Spreadsheet"
        xmlns:worksheet="clr-namespace:Telerik.Windows.Controls.Spreadsheet.Worksheets;assembly=Telerik.Windows.Controls.Spreadsheet"
        xmlns:spreadsheetRibbon="clr-namespace:Telerik.Windows.Controls;assembly=Telerik.Windows.Controls.SpreadsheetUI"
        xmlns:xlsx="clr-namespace:Telerik.Windows.Documents.Spreadsheet.FormatProviders.OpenXml.Xlsx;assembly=Telerik.Windows.Documents.Spreadsheet.FormatProviders.OpenXml"
        xmlns:csv="clr-namespace:Telerik.Windows.Documents.Spreadsheet.FormatProviders.TextBased.Csv;assembly=Telerik.Windows.Documents.Spreadsheet"
        xmlns:txt="clr-namespace:Telerik.Windows.Documents.Spreadsheet.FormatProviders.TextBased.Txt;assembly=Telerik.Windows.Documents.Spreadsheet"
        Background="#F3F3F3"
        Title="MainWindow" Height="1000" Width="1600">

    <Grid x:Name="LayoutRoot">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="400"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="435" MinWidth="435" MaxWidth="600"/>
            <ColumnDefinition Width="3"/>
        </Grid.ColumnDefinitions>

        <!-- Spreadsheet area with ribbon, formula bar, spreadsheet, and status bar -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <spreadsheetRibbon:RadSpreadsheetRibbon Grid.Row="0" RadSpreadsheet="{Binding ElementName=radSpreadsheet}" BackstageClippingElement="{Binding ElementName=LayoutRoot}"/>

            <spreadsheetControls:RadSpreadsheetFormulaBar Grid.Row="1" RadSpreadsheet="{Binding ElementName=radSpreadsheet, Mode=OneTime}" />

            <telerik:RadSpreadsheet x:Name="radSpreadsheet" Grid.Row="2" telerik:Analytics.Name="radSpreadsheet">
                <telerik:RadSpreadsheet.FormatProviders>
                    <txt:TxtFormatProvider />
                    <csv:CsvFormatProvider />
                    <xlsx:XlsxFormatProvider />
                </telerik:RadSpreadsheet.FormatProviders>
            </telerik:RadSpreadsheet>

            <spreadsheetControls:RadSpreadsheetStatusBar Grid.Row="3" RadSpreadsheet="{Binding ElementName=radSpreadsheet, Mode=OneTime}" />
        </Grid>

        <!-- Splitter between spreadsheet and chat -->
        <GridSplitter Grid.Column="1" 
                      Margin="0 70 0 0"
                      HorizontalAlignment="Stretch" 
                      VerticalAlignment="Stretch"
                      Background="#E0E0E0"
                      ResizeBehavior="PreviousAndNext"
                      ResizeDirection="Columns"/>

        <!-- Chat panel -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.Resources>
                <!-- Custom Suggestions Template for Spreadsheet -->
                <DataTemplate x:Key="SpreadsheetSuggestionsTemplate">
                    <telerik:RadExpander x:Name="PART_radExpander"
                                         VerticalContentAlignment="Top"
                                         IsExpanded="True"
                                         Margin="0,10,0,10">
                        <telerik:RadExpander.Header>
                            <TextBlock Text="Spreadsheet Suggestions" AutomationProperties.Name="AI Prompt Suggestions" />
                        </telerik:RadExpander.Header>
                        <telerik:RadExpander.Content>
                            <StackPanel Orientation="Vertical">
                                <telerik:RadButton Content="What is the value on cell A4?" 
                                                   Click="SuggestionButton_Click"
                                                   Tag="What is the value on cell A4?"
                                                   Margin="5" 
                                                   HorizontalContentAlignment="Left" 
                                                   HorizontalAlignment="Left"/>
                                <telerik:RadButton Content="How many registrations are there in Snohomish County?" 
                                                   Click="SuggestionButton_Click"
                                                   Tag="How many registrations are there in Snohomish County?"
                                                   Margin="5" 
                                                   HorizontalContentAlignment="Left" 
                                                   HorizontalAlignment="Left"/>
                            </StackPanel>
                        </telerik:RadExpander.Content>
                    </telerik:RadExpander>
                </DataTemplate>
            </Grid.Resources>

            <Border Grid.Row="0" BorderThickness="1 1 1 0" 
                    Margin="7 68 0 0"
                    Padding="7 0 7 6"
                    Background="White"
                    BorderBrush="#FFECECEC"
                    CornerRadius="8 8 8 0">
                <conversational:PdfChat x:Name="radChat"         
                             Background="Transparent"
                             CurrentAuthor="{Binding CurrentAuthor, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             InputBoxWatermarkContent="Ask AI about your spreadsheet..."
                             AdditionalContentTemplate="{StaticResource SpreadsheetSuggestionsTemplate}"/>
            </Border>
            <Grid Margin="16 0 0 235" VerticalAlignment="Bottom" x:Name="typingIndicator" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.Triggers>
                    <EventTrigger RoutedEvent="Grid.Loaded">
                        <BeginStoryboard>
                            <Storyboard Name="waitingAnimation" RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetName="Dot1" BeginTime="0:0:0.1" Storyboard.TargetProperty="Opacity" From=".3" To="0.7" AutoReverse="True" Duration="0:0:0.5"/>
                                <DoubleAnimation Storyboard.TargetName="Dot2" BeginTime="0:0:0.2" Storyboard.TargetProperty="Opacity" From=".3" To="0.7" AutoReverse="True" Duration="0:0:0.5"/>
                                <DoubleAnimation Storyboard.TargetName="Dot3" BeginTime="0:0:0.3" Storyboard.TargetProperty="Opacity" From=".3" To="0.7" AutoReverse="True" Duration="0:0:0.5"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Grid.Triggers>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="5 0">
                    <Ellipse Name="Dot1" Fill="#FF000000" Opacity=".3" Width="8" Height="8"/>
                    <Ellipse Name="Dot2" Fill="#FF000000" Opacity=".3" Width="8" Height="8" Margin="4 0 0 0"/>
                    <Ellipse Name="Dot3" Fill="#FF000000" Opacity=".3" Width="8" Height="8" Margin="4 0 0 0"/>
                </StackPanel>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="AI is thinking" Opacity="0.8" Margin="5 2 5 0"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
